# OpenRouter API key (https://openrouter.ai/keys) — used by all agents via LiteLLM
OPENROUTER_API_KEY=your-openrouter-key-here

# Model (must be an OpenRouter model id with openrouter/ prefix). Must support
# forced tool-calling (tool_choice=required) — the A2UI tab's generate_a2ui
# flow requires it, and GLM-4.5 rejects it ("Tool choice must be auto").
# gpt-4o-mini works but can emit malformed JSON for complex nested components
# (e.g. a form's fields array), exhausting the retry budget. deepseek-v4-pro
# is much more reliable for this but slower (~30-45s per A2UI generation).
AGENT_MODEL=openrouter/deepseek/deepseek-v4-pro

# Ports (defaults shown)
# ORCHESTRATOR_PORT=8000
# RESEARCH_PORT=9001
# ANALYSIS_PORT=9002
